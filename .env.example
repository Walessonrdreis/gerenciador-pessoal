# ============================================================
# Gerenciador Pessoal — variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` e preencha os valores reais.
# ============================================================

# --- Banco de dados (Neon/PostgreSQL) ---
# URL da conexão principal (usada pelo app em dev/prod)
DATABASE_URL="postgresql://usuario:senha@host:5432/gerenciador-pessoal?sslmode=require"

# URL do banco de TESTE (usada pelo Vitest — ver tests/setup.ts)
TEST_DATABASE_URL="postgresql://usuario:senha@host:5432/gerenciador-pessoal-test?sslmode=require"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="gere-um-segredo-com-pelo-menos-32-caracteres"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="cole-o-client-id-do-google"
AUTH_GOOGLE_SECRET="cole-o-client-secret-do-google"

# --- Fila de tarefas (Upstash QStash) ---
QSTASH_TOKEN=""
QSTASH_SIGNING_KEY=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_URL=""

# --- Notificações push (Web Push / VAPID) ---
# Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:exemplo@dominio.com"
